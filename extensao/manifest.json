{
  "manifest_version": 3,
  "name": "RCO para IMAS",
  "version": "3.0.2",
  "description": "Cria, encerra (fotos + Salvar) e dá baixa das OS do app RCO no IMAS, uma por vez, com conferência antes e depois.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "https://rco-manutencao.fernandorosa-mb.chatgpt.site/*",
    "https://admin.rcoengenharia.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RCO para IMAS"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rco-manutencao.fernandorosa-mb.chatgpt.site/*"
      ],
      "js": [
        "rco.js"
      ]
    }
  ]
}